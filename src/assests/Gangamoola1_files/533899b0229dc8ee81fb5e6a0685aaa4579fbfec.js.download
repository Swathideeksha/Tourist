    <html>
    <head>
        <script src="/scripts/js/jquery-1.9.1.min.js"></script>
        <title>Book a trip</title>
    </head>
    <body>
    <script type="text/javascript">
        $(window).load(function () {
            var i = setInterval(function () {
                if ((window.innerHeight > 0) &&
                    (window.innerWidth > 0) &&
                    (window.outerWidth > 0) &&
